# Copy to .env.local. Never commit real secrets.
# Generate each hash with: npm run password:hash
FAMILY_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Neon Postgres and private Cloudflare R2 photo storage.
DATABASE_URL=
# Keep this only while legacy Blob originals still need to be read.
BLOB_READ_WRITE_TOKEN=
R2_ENDPOINT=https://5fdfcf94759d7740311baa0d897374d0.r2.cloudflarestorage.com
R2_BUCKET=catoctin
R2_PREFIX=preview
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Total reserved upload bytes. Reservations include incomplete uploads.
MAX_STORAGE_BYTES=10737418240

# Shared Google album links are server-only; never commit real URLs.
GOOGLE_ALBUM_2026_URL=
GOOGLE_ALBUM_2025_URL=
GOOGLE_ALBUM_2024_URL=
GOOGLE_ALBUM_2010_URL=
